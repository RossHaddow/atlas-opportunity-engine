NODE_ENV=production
PORT=3000
# Local default: ./runtime-data
# Render persistent disk: /var/data
ATLAS_DATA_DIR=/var/data
ATLAS_BACKUP_LIMIT=50

ATLAS_REQUIRE_PERSISTENCE=true

# Build 36 live access protection. Leave ATLAS_ACCESS_PASSWORD blank only for local development.
ATLAS_ACCESS_USERNAME=atlas
ATLAS_ACCESS_PASSWORD=
ATLAS_REQUIRE_AUTH=true

# Build 41 daily focus review boundary. Defaults to America/Chicago.
ATLAS_TIME_ZONE=America/Chicago

# Build 82 optional live discovery adapter. The endpoint must accept Atlas's JSON job contract and return { candidates: [...], raw_result_count?: number }.
ATLAS_DISCOVERY_HTTP_URL=
ATLAS_DISCOVERY_HTTP_TOKEN=
ATLAS_DISCOVERY_HTTP_TIMEOUT_MS=30000
# Build 83 direct OpenAI web discovery. Set both key and model to enable it.
# In auto mode, ATLAS_DISCOVERY_HTTP_URL takes priority when both providers are configured.
ATLAS_DISCOVERY_PROVIDER=auto
ATLAS_OPENAI_API_KEY=
ATLAS_OPENAI_MODEL=
ATLAS_OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
ATLAS_OPENAI_WEB_SEARCH_TOOL=web_search_preview


# Build 84 autonomous discovery. Requires a configured live discovery provider.
ATLAS_DISCOVERY_AUTORUN=false
ATLAS_DISCOVERY_AUTORUN_INTERVAL_MINUTES=60
ATLAS_DISCOVERY_AUTORUN_COOLDOWN_HOURS=24
ATLAS_DISCOVERY_AUTORUN_MAX_JOBS=1

# Build 85: zero-cost Radar triage. Disable only if you want recommendations evaluated manually.
ATLAS_RADAR_AUTOTRIAGE=true
ATLAS_RADAR_AUTOTRIAGE_SUPPRESS_LOW_PRIORITY=true
ATLAS_RADAR_AUTOTRIAGE_SUPPRESS_DUPLICATES=true

# Build 89: opt-in targeted research-assist workflow
ATLAS_RESEARCH_ASSIST=false
# Travel Build 4 — optional live research providers. A provider is only marked ready when both name and API key are present.
ATLAS_TRAVEL_FLIGHTS_PROVIDER=
ATLAS_TRAVEL_FLIGHTS_API_KEY=
ATLAS_TRAVEL_LODGING_PROVIDER=
ATLAS_TRAVEL_LODGING_API_KEY=
ATLAS_TRAVEL_WEATHER_PROVIDER=
ATLAS_TRAVEL_WEATHER_API_KEY=
ATLAS_TRAVEL_AVAILABILITY_PROVIDER=
ATLAS_TRAVEL_AVAILABILITY_API_KEY=

