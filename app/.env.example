NODE_ENV=production
PORT=3000
# Local default: ./runtime-data
# Render persistent disk: /var/data
ATLAS_DATA_DIR=/var/data
ATLAS_BACKUP_LIMIT=50

ATLAS_REQUIRE_PERSISTENCE=true

# Build 36 live access protection. Leave ATLAS_ACCESS_PASSWORD blank only for local development.
ATLAS_ACCESS_USERNAME=atlas
ATLAS_ACCESS_PASSWORD=
ATLAS_REQUIRE_AUTH=true
